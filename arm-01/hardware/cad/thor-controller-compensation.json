  "findings": [
    {
      "id": "ros_relative_joint_definition",
      "source_id": "ros",
      "path": "ws_thor/src/thor_urdf/urdf/thor.urdf.xacro",
      "lines": [
        314,
        330
      ],
      "interpretation": "joint_3 rotates link_3 relative to parent link_2; it is not an independently declared world-frame forearm angle."
    },
    {
      "id": "ros_write_uncoupled",
      "source_id": "ros",
      "path": "ws_thor/src/thor_controller/src/thor_interface.cpp",
      "lines": [
        269,
        309
      ],
      "interpretation": "art2 and art3 are independently truncated degree transforms; GRBL B/C share art2 and D receives art3; Fly Y receives art2 and Z receives art3. No q2 term enters art3."
    },
    {
      "id": "ros_read_uncoupled",
      "source_id": "ros",
      "path": "ws_thor/src/thor_controller/src/thor_interface.cpp",
      "lines": [
        155,
        203
      ],
      "interpretation": "Both read paths independently negate shoulder and elbow degree coordinates; neither subtracts a carrier term. The values are channel-derived states, not independent joint encoders."
    },
    {
      "id": "asgard_manual_channels",
      "source_id": "asgard",
      "path": "asgard.py",
      "lines": [
        197,
        250
      ],
      "interpretation": "FKMoveArt2 sends B/C without D; FKMoveArt3 sends D without B/C. This is a manual channel interface, not proof of physical relative joint coordinates."
    },
